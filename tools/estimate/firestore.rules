// ==========================================================================
// 空調王で使う Firestore のルール
// --------------------------------------------------------------------------
// Firebase コンソール → Firestore Database → ルール　に、これを丸ごと貼り付けて
// 「公開」を押す。
//
// ★ 2026-09-12、月額の鍵のために _lic と _app を足しました。
//   **貼り直していないと、誰も空調王を開けません。**（[[project-kuchoo-lock]]）
//
// 何をしているか
//   ・ログインしていない相手は、読むことも書くこともできない
//   ・置き場所の名前は「64桁の16進数＋決まった名前」の形だけ許す
//     （当てずっぽうで他人の置き場所を作られないようにする）
//       _work   … 現場・見積・請求書
//       _master … 単価マスタ・機種データ・別売品
//       _plist  … 現場写真が何枚あるかの一覧
//       _p_<id> … 現場写真そのもの（1枚1件）
//       _lic    … 契約者の札（期限・契約者名・本体を開く合鍵）　← 読むだけ
//       _app    … 空調王の本体そのもの　　　　　　　　　　　　　← 読むだけ
//   ・1件に入れられるのは blob と at の2つだけ。大きさも制限する
//   ・消せるのは写真（_p_…）だけ。現場や見積を丸ごと消させない
//   ・ここに書いていない場所は、すべて禁止（Firestore の初期状態）
//
// なお、ここを万一まちがえても、中身は端末の中で暗号にしてから預けているので
// 読める文章にはなりません。守りは二重にしてあります。
//
// --------------------------------------------------------------------------
// ■ _lic と _app に「書く」許可が無いのは、わざとです
//
// 本体を書き換えられたら、その人の空調王に何でも仕込めてしまいます。
// だからお客さんの端末からは**絶対に書かせません**。
// 載せるのは BIGBOSS の手元の道具（_kuchoo-admin/admin.mjs）だけで、
// あちらはサービスアカウントで動くので、このルールを通り越して書けます。
// ==========================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /airtec/{doc} {
      // 読めるのは、決まった形の名前だけ。
      // 名前は「あいことば／ライセンスキー／合鍵」から作った64桁なので、
      // それを知らない人には、そもそも在処が分からない。
      allow read: if request.auth != null
                  && doc.matches('^[0-9a-f]{64}_(work|master|plist|lic|app|p_[A-Za-z0-9]{1,64})$');

      // 書き込みは「blob と at だけ・950KBまで」の形しか通さない。
      // ★ lic と app は、ここにわざと入れていない（上の説明を読むこと）
      allow create, update: if request.auth != null
                   && doc.matches('^[0-9a-f]{64}_(work|master|plist|p_[A-Za-z0-9]{1,64})$')
                   && request.resource.data.keys().hasOnly(['blob', 'at'])
                   && request.resource.data.blob is string
                   && request.resource.data.blob.size() <= 950000
                   && request.resource.data.at is int;

      // 消すのは写真だけ。消すときは中身が無いので、形の検査はできない
      // （検査を書くと、その場で必ず失敗して一生消せなくなる）
      allow delete: if request.auth != null
                    && doc.matches('^[0-9a-f]{64}_p_[A-Za-z0-9]{1,64}$');
    }

  }
}
