// ==========================================================================
// 空調王の連動で使う Firestore のルール
// --------------------------------------------------------------------------
// Firebase コンソール → Firestore Database → ルール　に、これを丸ごと貼り付けて
// 「公開」を押す。
//
// 何をしているか
//   ・ログインしていない相手は、読むことも書くこともできない
//   ・置き場所の名前は「64桁の16進数＋決まった名前」の形だけ許す
//     （当てずっぽうで他人の置き場所を作られないようにする）
//       _work   … 現場・見積・請求書
//       _master … 単価マスタ・機種データ
//       _plist  … 現場写真が何枚あるかの一覧
//       _p_<id> … 現場写真そのもの（1枚1件）
//   ・1件に入れられるのは blob と at の2つだけ。大きさも制限する
//   ・消せるのは写真（_p_…）だけ。現場や見積を丸ごと消させない
//   ・ここに書いていない場所は、すべて禁止（Firestore の初期状態）
//
// なお、ここを万一まちがえても、中身は端末の中で暗号にしてから預けているので
// 読める文章にはなりません。守りは二重にしてあります。
// ==========================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /airtec/{doc} {
      allow read: if request.auth != null
                  && doc.matches('^[0-9a-f]{64}_(work|master|plist|p_[A-Za-z0-9]{1,64})$');

      // 書き込みは「blob と at だけ・950KBまで」の形しか通さない
      allow create, update: if request.auth != null
                   && doc.matches('^[0-9a-f]{64}_(work|master|plist|p_[A-Za-z0-9]{1,64})$')
                   && request.resource.data.keys().hasOnly(['blob', 'at'])
                   && request.resource.data.blob is string
                   && request.resource.data.blob.size() <= 950000
                   && request.resource.data.at is int;

      // 消すのは写真だけ。消すときは中身が無いので、形の検査はできない
      // （検査を書くと、その場で必ず失敗して一生消せなくなる）
      allow delete: if request.auth != null
                    && doc.matches('^[0-9a-f]{64}_p_[A-Za-z0-9]{1,64}$');
    }

  }
}
